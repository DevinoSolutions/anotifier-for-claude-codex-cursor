# Google Analytics 4 measurement id (e.g. G-XXXXXXXXXX). Public, not a secret.
# Leave empty to disable analytics entirely: the build then ships no gtag.js.
# NEXT_PUBLIC_* is inlined at build time, so this must be set BEFORE
# `npm run build` (or passed as a Docker build arg) — a restart won't pick it up.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# PostHog project API key (phc_...). Public, not a secret. Same build-time rule
# as above. Leave empty to ship no PostHog. The host defaults to /_t/n4q on
# the site itself, which nginx.conf forwards to https://posthog.devino.ca.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Sentry DSN of the anotifier-landing project (project 67 on the self-hosted
# Sentry), for session replay. Public, not a secret. Same build-time rule as
# above. Leave empty to ship no Sentry. Events go through the /_t/s7e tunnel on
# the site itself, which nginx.conf forwards to
# https://sentry.devino.ca/api/67/envelope/.
NEXT_PUBLIC_SENTRY_DSN=
